{
  "name": "wraiter",
  "version": "0.17.0",
  "private": true,
  "description": "Desktop writing with integrated AI assistance.",
  "author": "WRAITER",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "electron .",
    "package": "npm run notices && npm run build && electron-builder --win nsis portable --x64",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "test:app": "node tests/app.cjs",
    "test:formatting": "node tests/formatting-ui.cjs",
    "test:revision-tools": "node tests/revision-tools-ui.cjs",
    "test:context-menu": "node tests/context-menu-ui.cjs",
    "test:v03": "node tests/v03-app.cjs",
    "test:history-recovery": "node tests/history-recovery-ui.cjs",
    "test:version-tree": "node tests/version-tree-ui.cjs",
    "test:undo-scroll": "node tests/undo-scroll-ui.cjs",
    "test:file-open": "node tests/file-open-ui.cjs",
    "test:installer": "node tests/installer-associations.cjs",
    "test:pdf": "node tests/pdf-layout.cjs",
    "test:pdf-export": "node tests/pdf-export.cjs",
    "test:office": "node tests/formats-interoperability.cjs",
    "test:io": "node tests/io-browser.cjs",
    "test:clipboard": "node tests/export-clipboard.cjs",
    "test:images": "node tests/image-import-ui.cjs",
    "test:ux": "node tests/document-ux-ui.cjs",
    "test:settings": "node tests/settings-ui.cjs",
    "test:rephrase-vibe": "node tests/rephrase-vibe-ui.cjs",
    "test:suggestion-counts": "node tests/suggestion-counts-ui.cjs",
    "test:desktop": "node tests/desktop-ipc.cjs",
    "test:v04": "node tests/v04-app.cjs",
    "test:local-live": "node tests/local-live.cjs",
    "test:v05": "node tests/v05-app.cjs",
    "test:v06": "node tests/v06-app.cjs",
    "test:large": "node tests/large-manuscript-ui.cjs",
    "test:navigation": "node tests/paragraph-navigation-ui.cjs",
    "test:soak": "node tests/soak-ui.cjs",
    "test:large-search": "node tests/large-search-ui.cjs",
    "test:search-panel": "node tests/search-panel-browser.cjs",
    "test:font-picker": "node tests/font-picker-browser.cjs",
    "test:font-picker-desktop": "node tests/font-picker-ui.cjs",
    "test:native-save-errors": "node tests/native-save-errors-ui.cjs",
    "test:windows-locks": "node tests/windows-locks.cjs",
    "test:crash-recovery": "node tests/crash-recovery-ui.cjs",
    "test:scrolling": "node tests/scrolling-ui.cjs",
    "test:reload-numbering": "node tests/reload-numbering-ui.cjs",
    "test:long-numbering": "node tests/long-numbering-ui.cjs",
    "test:proofreading": "node tests/proofreading-ui.cjs",
    "test:onboarding": "node tests/onboarding-ui.cjs",
    "test:tutorial": "node tests/tutorial-ui.cjs",
    "test:tutorial:live": "node tests/tutorial-live.cjs",
    "notices": "node tools/third-party-notices.cjs",
    "test:editorial": "node tests/editorial-ui.cjs"
  },
  "devDependencies": {
    "@tiptap/extension-placeholder": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@vitejs/plugin-react": "6.1.1",
    "docx": "9.7.1",
    "dompurify": "3.4.15",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "jszip": "3.10.2",
    "lucide-react": "0.577.0",
    "mammoth": "1.12.3",
    "markdown-it": "15.0.2",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.0"
  },
  "build": {
    "appId": "studio.wraiter.desktop",
    "productName": "WRAITER",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "assets/**/*",
      "LICENSE",
      "THIRD-PARTY-NOTICES.md"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "WRAITER-${version}-Windows.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "artifactName": "WRAITER-${version}-Setup.exe",
      "include": "build/installer.nsh"
    },
    "extraFiles": [
      "LICENSE",
      "THIRD-PARTY-NOTICES.md"
    ]
  },
  "type": "module",
  "homepage": "https://github.com/LEC1224/WRAITER#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/LEC1224/WRAITER.git"
  },
  "bugs": {
    "url": "https://github.com/LEC1224/WRAITER/issues"
  },
  "dependencies": {
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-highlight": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-text-align": "3.31.3",
    "@tiptap/extension-text-style": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "diff": "9.0.0"
  }
}
