{
  "name": "wraiter",
  "version": "0.21.0-rc.4",
  "private": true,
  "description": "Desktop writing with integrated AI assistance.",
  "author": "WRAITER",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "build:web": "vite build --config vite.web.config.js",
    "start:cloud": "node cloud/server.cjs",
    "test:cloud": "node --test cloud/cloud.test.cjs tests/cloud-client.test.cjs",
    "test:web-cloud": "node tests/web-cloud-ui.cjs",
    "test:cloud-mobile": "node tests/cloud-mobile-ui.cjs",
    "package:cloud": "node tools/package-cloud.cjs",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node tools/prepare-offline-grammar.cjs && node tools/prepare-neural-grammar.cjs",
    "build": "vite build",
    "start": "electron .",
    "package": "node tools/package-windows.cjs",
    "package:preview": "node tools/package-windows.cjs --unsigned-preview",
    "package:store": "node tools/store-package.cjs",
    "package:store:preview": "node tools/store-package.cjs --preview",
    "verify:store": "node tools/verify-store-package.cjs",
    "store:assets": "node tools/store-assets.cjs",
    "store:screenshots": "node tools/store-screenshots.cjs",
    "verify:windows-release": "node tools/verify-windows-release.cjs",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "test:app": "node tests/app.cjs",
    "test:formatting": "node tests/formatting-ui.cjs",
    "test:revision-tools": "node tests/revision-tools-ui.cjs",
    "test:context-menu": "node tests/context-menu-ui.cjs",
    "test:v03": "node tests/v03-app.cjs",
    "test:history-recovery": "node tests/history-recovery-ui.cjs",
    "test:version-tree": "node tests/version-tree-ui.cjs",
    "test:undo-scroll": "node tests/undo-scroll-ui.cjs",
    "test:file-open": "node tests/file-open-ui.cjs",
    "test:installer": "node tests/installer-associations.cjs",
    "test:installer-package": "node tests/installer-package.cjs",
    "test:pdf": "node tests/pdf-layout.cjs",
    "test:pdf-export": "node tests/pdf-export.cjs",
    "test:highlight-export": "node tests/highlight-export.cjs",
    "test:highlight-export-ui": "node tests/highlight-export-ui.cjs",
    "test:office": "node tests/formats-interoperability.cjs",
    "test:io": "node tests/io-browser.cjs",
    "test:clipboard": "node tests/export-clipboard.cjs",
    "test:export-settings": "node tests/export-settings-ui.cjs",
    "test:images": "node tests/image-import-ui.cjs",
    "test:ux": "node tests/document-ux-ui.cjs",
    "test:settings": "node tests/settings-ui.cjs",
    "test:logging": "node tests/logging-ui.cjs",
    "test:rephrase-vibe": "node tests/rephrase-vibe-ui.cjs",
    "test:suggestion-counts": "node tests/suggestion-counts-ui.cjs",
    "test:desktop": "node tests/desktop-ipc.cjs",
    "test:v04": "node tests/v04-app.cjs",
    "test:local-live": "node tests/local-live.cjs",
    "test:v05": "node tests/v05-app.cjs",
    "test:v06": "node tests/v06-app.cjs",
    "test:multitask": "node tests/multitask-ui.cjs",
    "test:multitask-sidebar": "node tests/multitask-sidebar-ui.cjs",
    "test:multitask-layout": "node tests/multitask-layout-ui.cjs",
    "test:multitask-selection": "node tests/multitask-selection-ui.cjs",
    "test:multitask-resident": "node tests/multitask-resident-ui.cjs",
    "test:multitask-text-drag": "node tests/multitask-text-drag-ui.cjs",
    "test:large": "node tests/large-manuscript-ui.cjs",
    "test:navigation": "node tests/paragraph-navigation-ui.cjs",
    "test:soak": "node tests/soak-ui.cjs",
    "test:large-search": "node tests/large-search-ui.cjs",
    "test:search-panel": "node tests/search-panel-browser.cjs",
    "test:font-picker": "node tests/font-picker-browser.cjs",
    "test:font-picker-desktop": "node tests/font-picker-ui.cjs",
    "test:native-save-errors": "node tests/native-save-errors-ui.cjs",
    "test:windows-locks": "node tests/windows-locks.cjs",
    "test:crash-recovery": "node tests/crash-recovery-ui.cjs",
    "test:scrolling": "node tests/scrolling-ui.cjs",
    "test:reload-numbering": "node tests/reload-numbering-ui.cjs",
    "test:long-numbering": "node tests/long-numbering-ui.cjs",
    "test:proofreading": "node tests/proofreading-ui.cjs",
    "test:ai-grammar": "node tests/ai-grammar-ui.cjs",
    "test:ai-grammar-coverage": "node tests/ai-grammar-coverage-ui.cjs",
    "test:ai-grammar-ipc": "node tests/inline-grammar-ipc.cjs",
    "test:local-writing-tools": "node tests/local-writing-tools-ui.cjs",
    "test:offline-grammar": "node tests/offline-grammar-ui.cjs",
    "test:offline-grammar-large": "node tests/offline-grammar-large-ui.cjs",
    "test:offline-grammar-paragraph": "node tests/offline-grammar-paragraph-ui.cjs",
    "test:offline-grammar-recovery": "node tests/offline-grammar-recovery-ui.cjs",
    "test:offline-grammar-soak": "node tests/offline-grammar-soak-ui.cjs",
    "test:offline-grammar-process-soak": "node tests/offline-grammar-process-soak.cjs",
    "test:offline-dictionaries": "node tests/offline-dictionaries-ui.cjs",
    "test:offline-dialects": "node tests/offline-grammar-dialects-ui.cjs",
    "test:offline-network": "node tests/offline-network-ui.cjs",
    "test:onboarding": "node tests/onboarding-ui.cjs",
    "test:store": "node tests/store-ui.cjs",
    "test:tutorial": "node tests/tutorial-ui.cjs",
    "test:continuation": "node tests/continuation-ui.cjs",
    "test:tutorial:live": "node tests/tutorial-live.cjs",
    "notices": "node tools/third-party-notices.cjs",
    "test:editorial": "node tests/editorial-ui.cjs"
  },
  "devDependencies": {
    "@tiptap/extension-placeholder": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@vitejs/plugin-react": "6.1.1",
    "dictionary-en": "4.0.0",
    "dictionary-en-au": "3.0.0",
    "dictionary-en-ca": "3.0.0",
    "dictionary-en-gb": "3.0.0",
    "docx": "9.7.1",
    "dompurify": "3.4.15",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "harper.js": "2.13.0",
    "jszip": "3.10.2",
    "lucide-react": "0.577.0",
    "mammoth": "1.12.3",
    "markdown-it": "15.0.2",
    "nspell": "2.1.5",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tar": "7.5.22",
    "vite": "8.3.0"
  },
  "build": {
    "appId": "studio.wraiter.desktop",
    "productName": "WRAITER",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/tabs.js",
      "src/named-styles.js",
      "src/cloud-vault.js",
      "package.json",
      "assets/**/*",
      "LICENSE",
      "THIRD-PARTY-NOTICES.md",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**/*"
    ],
    "asar": true,
    "forceCodeSigning": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico",
      "signExecutable": true,
      "signExts": [
        ".exe",
        ".dll"
      ]
    },
    "portable": {
      "artifactName": "WRAITER-${version}-Windows.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "artifactName": "WRAITER-${version}-Setup.exe",
      "include": "build/installer.nsh"
    },
    "extraFiles": [
      "LICENSE",
      "THIRD-PARTY-NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "build/offline-grammar/payload",
        "to": "offline-grammar"
      },
      {
        "from": "build/neural-grammar",
        "to": "neural-grammar"
      }
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/bin/**/*"
    ]
  },
  "type": "module",
  "homepage": "https://github.com/LEC1224/WRAITER#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/LEC1224/WRAITER.git"
  },
  "bugs": {
    "url": "https://github.com/LEC1224/WRAITER/issues"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "@noble/hashes": "2.4.0",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-highlight": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-text-align": "3.31.3",
    "@tiptap/extension-text-style": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "diff": "9.0.0",
    "onnxruntime-node": "1.31.1",
    "re2js": "2.9.1"
  }
}
