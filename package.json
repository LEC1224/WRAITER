{
  "name": "wraiter",
  "version": "0.1.0",
  "private": true,
  "description": "A quiet place to write, with AI within reach.",
  "author": "WRAITER",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "electron .",
    "package": "npm run build && electron-builder --win portable --x64",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "test:app": "node tests/app.cjs",
    "test:io": "node tests/io-browser.cjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@tiptap/extension-highlight": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-placeholder": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-text-align": "3.31.3",
    "@tiptap/extension-text-style": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "diff": "9.0.0",
    "docx": "9.7.1",
    "dompurify": "3.4.15",
    "jszip": "3.10.2",
    "lucide-react": "0.577.0",
    "mammoth": "1.12.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "playwright": "1.63.0",
    "vite": "8.3.0",
    "@tiptap/core": "3.31.3"
  },
  "build": {
    "appId": "studio.wraiter.desktop",
    "productName": "WRAITER",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "assets/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "WRAITER-${version}-Windows.exe"
    }
  },
  "type": "module"
}
