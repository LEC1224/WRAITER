<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <httpErrors existingResponse="PassThrough" />
    <rewrite>
      <rules>
        <clear />
        <rule name="Certificate renewal" stopProcessing="true">
          <match url="^\.well-known/acme-challenge/" />
          <action type="None" />
        </rule>
        <rule name="WRAITER HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions><add input="{HTTPS}" pattern="^OFF$" /></conditions>
          <action type="Redirect" url="https://write.example.org/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="WRAITER Cloud" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables><set name="HTTP_X_FORWARDED_PROTO" value="https" /></serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:3020/{R:1}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
    <httpProtocol><customHeaders><remove name="X-Powered-By" /></customHeaders></httpProtocol>
    <security><requestFiltering removeServerHeader="true"><requestLimits maxAllowedContentLength="104857600" /></requestFiltering></security>
  </system.webServer>
</configuration>
