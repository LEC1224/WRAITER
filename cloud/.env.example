HOST=127.0.0.1
PORT=3020
WRAITER_ORIGIN=http://127.0.0.1:3020
WRAITER_SECURE_COOKIES=0
# Use an HTTPS origin and secure cookies in production.
# WRAITER_MAIL_FROM=noreply@example.net
# WRAITER_RESEND_KEY=

# The desktop and browser can use the same account service. For a deployment:
# WRAITER_ORIGIN=https://write.example.org
# WRAITER_SECURE_COOKIES=1
# WRAITER_TRUST_PROXY=1
# WRAITER_DATA_DIR=C:/ProgramData/WRAITER/cloud/data
# WRAITER_STATIC_DIR=C:/ProgramData/WRAITER/cloud/dist-web
# A mail relay can be configured in place of the send-only API key.
# WRAITER_MAIL_RELAY_URL=
# WRAITER_MAIL_RELAY_SECRET=
# WRAITER_SUGGESTION_ADMIN_EMAIL=editor@example.org
# WRAITER_SUGGESTION_RELAY_KEY=
